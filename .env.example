# ==============================================================
# PriceSpy Pro - Full-Stack Environment Configuration Example
# ==============================================================

# Backend Configuration
SECRET_KEY=replace_with_a_secure_random_64_character_hex_string
REDIS_HOST=localhost
REDIS_PORT=6379
DATABASE_URL=sqlite:///./pricespy.db
PORT=8000

# Optional SMTP Real Email Delivery (Gmail, SendGrid, etc.)
# If omitted, password resets and verification use instant in-app simulation
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_gmail_app_password
SMTP_FROM=your_email@gmail.com

# Frontend Configuration
REACT_APP_API_URL=https://pricespy-backend.onrender.com
GENERATE_SOURCEMAP=false
