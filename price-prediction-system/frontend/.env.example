# ==============================================================
# PriceSpy Pro - Frontend Environment Configuration Example
# ==============================================================

# URL of the deployed FastAPI Backend (No trailing slash)
# For local development: http://127.0.0.1:8000
# For production: https://pricespy-backend.onrender.com
REACT_APP_API_URL=http://127.0.0.1:8000

# Optional: Disable source map generation for smaller production bundles
GENERATE_SOURCEMAP=false
