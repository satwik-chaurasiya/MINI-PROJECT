# ==============================================================
# PriceSpy Pro - Backend Environment Configuration Example
# ==============================================================

# 1. Application Security
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_generated_secret_key_here

# 2. Redis Cache (Optional - Falls back to in-memory caching if omitted)
REDIS_HOST=localhost
REDIS_PORT=6379

# 3. Database URL (Optional - Defaults to local SQLite pricespy.db if omitted)
# For production PostgreSQL: postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./pricespy.db

# 4. Server Port (Set dynamically by cloud host like Render/Railway/Heroku)
PORT=8000
