# PriceSpy Backend Environment Variables Template
# Copy this file to .env and configure as needed.

# Security (JWT Authentication)
SECRET_KEY=supersecretkey_pricespy_ai_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Defaults to SQLite in backend/pricespy.db if not specified
# SQLALCHEMY_DATABASE_URL=sqlite:///./pricespy.db

# Email / Alert Dispatcher Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
